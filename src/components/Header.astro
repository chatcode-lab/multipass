---
import { PASSPORT_COLLECTIONS, POPULAR_COMPARISONS } from "@/lib/geography";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const collectionPaths = new Set(PASSPORT_COLLECTIONS.map((collection) => `/${collection.slug}`));
const comparisonPaths = new Set(POPULAR_COMPARISONS.map((comparison) => `/${comparison.slug}`));
const rankingActive = pathname === "/" || pathname === "/rank" || pathname.startsWith("/passport/") || collectionPaths.has(pathname);
const compareActive = pathname.startsWith("/compare") || comparisonPaths.has(pathname);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="MultiPass Rank home">
    <span class="brand__mark" aria-hidden="true"><i></i><i></i></span>
    <span>MultiPass <em>Rank</em></span>
  </a>
  <nav aria-label="Main navigation">
    <a href="/" aria-current={rankingActive ? "page" : undefined}>Ranking</a>
    <a href="/destinations" aria-current={pathname === "/destinations" ? "page" : undefined}>Destinations</a>
    <a href="/compare" aria-current={compareActive ? "page" : undefined}>Compare</a>
    <a href="/methodology" aria-current={pathname === "/methodology" ? "page" : undefined}>Methodology</a>
  </nav>
</header>

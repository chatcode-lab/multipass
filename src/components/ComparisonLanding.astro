---
import ComparisonTool from "@/components/ComparisonTool";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { PopularComparison } from "@/lib/geography";
import type { ComparisonResult, SnapshotManifest } from "@/lib/types";
import { ACCESS_EASE_WEIGHT } from "@/lib/passport-shared";
import { comparisonPageTitle } from "@/lib/seo-titles";

interface Props {
  comparison: PopularComparison;
  manifest: SnapshotManifest;
  result: ComparisonResult;
}

const { comparison, manifest, result } = Astro.props;
const initialSets = comparison.sets.map((codes) => [...codes]);
const [first, second] = result.scenarios;
const firstWins = result.rows.filter(({ cells }) => ACCESS_EASE_WEIGHT[cells[0].status] > ACCESS_EASE_WEIGHT[cells[1].status]).length;
const secondWins = result.rows.filter(({ cells }) => ACCESS_EASE_WEIGHT[cells[1].status] > ACCESS_EASE_WEIGHT[cells[0].status]).length;
const equalDestinations = result.rows.length - firstWins - secondWins;
const passportByCode = new Map(manifest.passports.map((passport) => [passport.code, passport]));
const firstPassport = passportByCode.get(first.codes[0]);
const secondPassport = passportByCode.get(second.codes[0]);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: comparison.heading,
    description: comparison.description,
    dateModified: manifest.checkedAt,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Compare passports", item: "https://multipassrank.com/compare" },
      { "@type": "ListItem", position: 2, name: comparison.shortTitle, item: `https://multipassrank.com/${comparison.slug}` },
    ],
  },
];
---

<BaseLayout
  title={comparisonPageTitle(comparison.shortTitle)}
  description={comparison.description}
  canonical={`/${comparison.slug}`}
  markdownHref={`/${comparison.slug}.md`}
  structuredData={structuredData}
>
  <header class="page-intro page-intro--compare">
    <span class="eyebrow">Passport strength comparison</span>
    <h1>{comparison.heading}</h1>
    <p>{comparison.description}</p>
  </header>
  <section class="section section--tight">
    <ComparisonTool
      passports={manifest.passports}
      initialSets={initialSets}
      initialResult={result}
      client:load
    />
  </section>
  <section class="comparison-overview">
    <span class="eyebrow">What the scores show</span>
    <h2>{first.name} and {second.name}, side by side</h2>
    <p>
      {first.name} has a mobility score of <strong>{first.mobilityScore}</strong> and a rank equivalent of
      <strong> #{first.rankEquivalent}</strong>. {second.name} scores <strong>{second.mobilityScore}</strong>, equivalent to
      <strong> #{second.rankEquivalent}</strong>. Use “Differences only” above to isolate destinations where their entry categories differ.
    </p>
    <p>
      Using the comparison table’s access hierarchy, {first.name} has the easier result in <strong>{firstWins}</strong> destinations,
      {second.name} in <strong>{secondWins}</strong>, and they are equivalent in <strong>{equalDestinations}</strong>.
    </p>
    <p>{comparison.context}</p>
    <nav class="country-shortcuts" aria-label="Open the compared passport pages">
      {firstPassport && <a href={`/passport/${firstPassport.slug}`}>View {first.name} passport</a>}
      {secondPassport && <a href={`/passport/${secondPassport.slug}`}>View {second.name} passport</a>}
    </nav>
  </section>
</BaseLayout>

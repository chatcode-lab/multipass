---
import { WORLD_LAND_PATH } from "@/data/world-map";
import { formatRegion } from "@/lib/geography";
import type { Region } from "@/lib/types";

interface Props {
  country: string;
  region: Region;
}

const { country, region } = Astro.props;
const viewBoxes: Record<Region, string> = {
  AFRICA: "405 170 205 235",
  AMERICAS: "85 65 335 360",
  CARIBBEAN: "245 190 150 105",
  ASIA: "535 75 315 300",
  EUROPE: "425 42 175 130",
  "MIDDLE EAST": "500 155 180 135",
  OCEANIA: "700 245 220 190",
};
const regionLabel = formatRegion(region);
---

<figure class="region-map">
  <div class="region-map__canvas">
    <svg viewBox={viewBoxes[region]} role="img" aria-labelledby="region-map-title region-map-desc">
      <title id="region-map-title">{country} regional map</title>
      <desc id="region-map-desc">A simplified Natural Earth outline focused on {regionLabel}.</desc>
      <path d={WORLD_LAND_PATH} />
    </svg>
  </div>
  <figcaption><span aria-hidden="true"></span>{regionLabel} focus</figcaption>
</figure>

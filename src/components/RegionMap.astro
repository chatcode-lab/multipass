---
import { COUNTRY_MAPS, REGION_MAPS } from "@/data/world-map";
import { formatRegion } from "@/lib/geography";
import type { Region } from "@/lib/types";

interface Props {
  code: string;
  country: string;
  region: Region;
}

const { code, country, region } = Astro.props;
const regionMap = REGION_MAPS[region];
const countryMap = COUNTRY_MAPS[code];
const regionLabel = formatRegion(region);
---

<figure class="region-map">
  <div class="region-map__canvas">
    <svg viewBox={regionMap.viewBox} role="img" aria-labelledby="region-map-title region-map-desc">
      <title id="region-map-title">{country} regional map</title>
      <desc id="region-map-desc">A simplified Natural Earth outline of {regionLabel}, with {country} marked.</desc>
      <path class="region-map__context" d={regionMap.path} />
      {countryMap.path && <path class="region-map__country" d={countryMap.path} />}
      <circle class="region-map__marker-ring" cx={countryMap.marker[0]} cy={countryMap.marker[1]} r={regionMap.markerRadius * 1.9} />
      <circle class="region-map__marker" cx={countryMap.marker[0]} cy={countryMap.marker[1]} r={regionMap.markerRadius} />
    </svg>
  </div>
  <figcaption><span aria-hidden="true"></span>{country} in {regionLabel}</figcaption>
</figure>

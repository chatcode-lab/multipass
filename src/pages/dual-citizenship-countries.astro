---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CITIZENSHIP_POLICIES, CITIZENSHIP_POLICY_STATUS_META } from "@/data/citizenship-policies";
import { datasetMetadata } from "@/lib/dataset";
import { flagEmojiFor } from "@/lib/geography";
import { citizenshipPolicyAnchor } from "@/lib/citizenship-compatibility";

const description = "Compare official dual-citizenship rules for reviewed countries and check whether a proposed passport combination may require renunciation, retention, or age-specific review.";
const groups = ["generally_restricted", "conditional", "generally_allowed"] as const;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Reviewed multiple-citizenship policies",
    description,
    dateModified: "2026-08-28",
    spatialCoverage: CITIZENSHIP_POLICIES.map((policy) => policy.country),
    distribution: {
      "@type": "DataDownload",
      contentUrl: "https://multipassrank.com/api/v1/citizenship-policies",
      encodingFormat: "application/json",
    },
    ...datasetMetadata("https://multipassrank.com/dual-citizenship-countries"),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "MultiPass Rank", item: "https://multipassrank.com" },
      { "@type": "ListItem", position: 2, name: "Dual citizenship countries", item: "https://multipassrank.com/dual-citizenship-countries" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Which countries allow dual citizenship?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Rules differ by country and by how each nationality was acquired. This reviewed dataset distinguishes generally allowed, conditional, and generally restricted policies and links to official sources.",
        },
      },
      {
        "@type": "Question",
        name: "Does a passport combination calculator prove that the citizenships can legally be held together?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. A mobility calculation is hypothetical. Retention can depend on birth, naturalisation, age, residence, marriage, official permission and the law of every country involved.",
        },
      },
    ],
  },
];

Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=86400, stale-while-revalidate=604800");
---

<BaseLayout
  title="Dual Citizenship Countries & Passport Compatibility | MultiPass Rank"
  description={description}
  canonical="/dual-citizenship-countries"
  markdownHref="/dual-citizenship-countries.md"
  structuredData={structuredData}
>
  <article class="citizenship-guide">
    <header class="research-hero citizenship-guide__hero">
      <span class="eyebrow">Official-source policy review · 28 August 2026</span>
      <h1>Can these citizenships actually be held together?</h1>
      <p>
        A combined passport score is a useful hypothetical. Citizenship law is the constraint: some countries permit multiple
        nationalities, some make it conditional, and some generally require a choice.
      </p>
      <div class="research-actions research-actions--hero">
        <a class="button button--primary" href="/compare">Build a passport combination</a>
        <a class="button button--quiet" href="/how-many-passports-can-you-have">How many passports can one person have?</a>
      </div>
    </header>

    <section class="citizenship-explainer" aria-label="How to interpret citizenship compatibility">
      <article><span class="policy-dot policy-dot--generally_allowed"></span><h2>Generally allowed</h2><p>The reviewed country's law usually lets its citizenship coexist with another. The other country must still agree.</p></article>
      <article><span class="policy-dot policy-dot--conditional"></span><h2>Conditional</h2><p>The answer changes with acquisition route, age, residence, marriage, an exception, or a required procedure.</p></article>
      <article><span class="policy-dot policy-dot--generally_restricted"></span><h2>Generally restricted</h2><p>Voluntary foreign naturalisation or adulthood can trigger loss, renunciation, or a nationality-choice requirement.</p></article>
    </section>

    <div class="citizenship-guide__scope">
      <strong>{CITIZENSHIP_POLICIES.length} countries reviewed</strong>
      <p>This is an intentionally small, source-backed first release—not a guessed world map. Unreviewed countries produce no calculator warning yet.</p>
    </div>

    {groups.map((status) => {
      const policies = CITIZENSHIP_POLICIES.filter((policy) => policy.status === status);
      return (
        <section class={`citizenship-policy-group citizenship-policy-group--${status}`}>
          <header>
            <span class="eyebrow">{CITIZENSHIP_POLICY_STATUS_META[status].shortLabel}</span>
            <h2>{CITIZENSHIP_POLICY_STATUS_META[status].label}</h2>
            <strong>{policies.length}</strong>
          </header>
          <div class="citizenship-policy-list">
            {policies.map((policy) => (
              <article id={citizenshipPolicyAnchor(policy)}>
                <div class="citizenship-policy-card__heading">
                  <span class="country-flag" aria-hidden="true">{flagEmojiFor(policy.code)}</span>
                  <div><h3>{policy.country}</h3><span>Reviewed {policy.reviewedAt}</span></div>
                </div>
                <strong>{policy.headline}</strong>
                <p>{policy.summary}</p>
                <ul>{policy.practicalNotes.map((note) => <li>{note}</li>)}</ul>
                <div class="citizenship-policy-card__sources">
                  <span>Official {policy.sources.length === 1 ? "source" : "sources"}</span>
                  {policy.sources.map((source) => <a href={source.url} rel="noreferrer">{source.publisher}: {source.label}</a>)}
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="research-copy citizenship-guide__limits">
      <section>
        <span class="eyebrow">What a compatibility warning means</span>
        <h2>A caution, never a prohibition.</h2>
        <p>
          MultiPass Rank will still calculate every selected combination. A warning means only that an official source identifies
          a retention, loss, renunciation, age, or procedure issue worth checking. It cannot know how a person acquired each
          citizenship, whether an exception applies, or what a competent authority would decide.
        </p>
        <p>
          The next research passes will expand this register and separate acquisition routes—birth, descent, naturalisation,
          marriage, restoration and exceptional grants—from retention rules. That structure is more useful than a simplistic
          yes/no list and makes every future statement traceable to an official authority.
        </p>
      </section>
    </section>
  </article>
</BaseLayout>

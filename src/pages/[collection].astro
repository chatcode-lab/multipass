---
import RankingExplorer from "@/components/RankingExplorer.astro";
import ComparisonLanding from "@/components/ComparisonLanding.astro";
import VisaRelationshipPage from "@/components/VisaRelationshipPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDataContext, getPassportAccess, getPassportAccessBatch } from "@/lib/data";
import { getPassportCollection, getPopularComparison, PASSPORT_COLLECTIONS, passportsInCollection } from "@/lib/geography";
import { comparePassportSets } from "@/lib/passport";
import type { AccessStatus, PassportAccess } from "@/lib/types";
import { getVisaRelationshipEvidence, resolveVisaRelationshipSlug, visaRelationshipSlug } from "@/lib/visa-evidence";

const collection = getPassportCollection(Astro.params.collection);
const comparison = getPopularComparison(Astro.params.collection);
if (comparison && Astro.params.collection !== comparison.slug) {
  return new Response(null, {
    status: 308,
    headers: {
      Location: `/${comparison.slug}`,
      "Cache-Control": "public, max-age=3600",
    },
  });
}
const { manifest, source } = await getDataContext(Astro.locals);
const relationship = !collection && !comparison ? resolveVisaRelationshipSlug(Astro.params.collection, manifest) : null;
const relationshipDetail = relationship
  ? await getPassportAccess(Astro.locals, relationship.passport.code, manifest.version)
  : null;
const relationshipStatus = relationshipDetail
  ? relationshipDetail.statuses[relationship!.destination.code] ?? "unknown" as AccessStatus
  : null;
if (!collection && !comparison && (!relationship || !relationshipDetail || !relationshipStatus)) return Astro.rewrite("/404");
if (relationship && relationshipStatus) {
  if (relationshipStatus === "citizenship") {
    return new Response(null, {
      status: 308,
      headers: { Location: `/passport/${relationship.passport.slug}`, "Cache-Control": "public, max-age=3600" },
    });
  }
  const canonicalSlug = visaRelationshipSlug(relationship.passport, relationship.destination, relationshipStatus);
  if (Astro.params.collection !== canonicalSlug) {
    return new Response(null, {
      status: 308,
      headers: { Location: `/${canonicalSlug}`, "Cache-Control": "public, max-age=3600" },
    });
  }
}
const relationshipEvidence = relationship && relationshipStatus
  ? getVisaRelationshipEvidence(relationship.passport.code, relationship.destination.code, relationshipStatus)
  : null;
const passports = collection ? passportsInCollection(manifest.passports, collection) : [];
const comparisonSets = comparison?.sets.map((codes) => ({ codes: [...codes] })) ?? [];
const comparisonDetails: Record<string, PassportAccess> = comparison
  ? await getPassportAccessBatch(Astro.locals, comparisonSets.flatMap((set) => set.codes), manifest.version)
  : {};
const comparisonResult = comparison ? comparePassportSets(comparisonSets, manifest, comparisonDetails) : null;
const checkedDate = new Intl.DateTimeFormat("en", { day: "numeric", month: "short", year: "numeric" }).format(
  new Date(manifest.checkedAt),
);
Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400");
const structuredData = collection ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: collection.heading,
  numberOfItems: passports.length,
  itemListElement: passports.map((passport, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: passport.name,
    url: `https://multipassrank.com/passport/${passport.slug}`,
  })),
} : undefined;
---

{collection ? (
  <BaseLayout
    title={`${collection.heading} | MultiPass Rank`}
    description={collection.description}
    canonical={`/${collection.slug}`}
    markdownHref={`/${collection.slug}.md`}
    structuredData={structuredData}
  >
    <header class="collection-hero">
      <span class="eyebrow">{collection.eyebrow}</span>
      <h1>{collection.heading}</h1>
      <p>{collection.description}</p>
      <div class="collection-hero__meta">
        <strong>{passports.length}</strong> passports · {source === "live" ? "Data checked" : "Bundled snapshot"} {checkedDate}
      </div>
    </header>
    <section class="section section--tight">
      <nav class="collection-links" aria-label="Other passport rankings">
        {PASSPORT_COLLECTIONS.map((entry) => (
          <a href={`/${entry.slug}`} aria-current={entry.slug === collection.slug ? "page" : undefined}>{entry.name}</a>
        ))}
      </nav>
      <RankingExplorer
        passports={passports}
        scoped
        showRegionFilter={false}
        listLabel={collection.heading}
      />
    </section>
  </BaseLayout>
) : comparison && comparisonResult ? (
  <ComparisonLanding comparison={comparison} manifest={manifest} result={comparisonResult} />
) : relationship && relationshipStatus && relationshipEvidence ? (
  <VisaRelationshipPage
    manifest={manifest}
    passport={relationship.passport}
    destination={relationship.destination}
    status={relationshipStatus}
    evidence={relationshipEvidence}
    source={source}
  />
) : null}

---
import DestinationPassportAccess from "@/components/DestinationPassportAccess.astro";
import VisaEvidenceTimeline from "@/components/VisaEvidenceTimeline.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDataContext, getPassportAccessBatch } from "@/lib/data";
import { datasetMetadata } from "@/lib/dataset";
import { flagEmojiFor, formatRegion } from "@/lib/geography";
import { STATUS_META } from "@/lib/passport";
import { ACCESS_STATUSES, type AccessStatus } from "@/lib/types";
import { destinationSlug, officialSourcesForPolicies, policiesForDestination } from "@/lib/visa-evidence";

const { manifest, source } = await getDataContext(Astro.locals);
const destination = manifest.destinations.find((entry) => destinationSlug(entry) === Astro.params.slug);
if (!destination) return Astro.rewrite("/404");
const details = await getPassportAccessBatch(Astro.locals, manifest.passports.map((passport) => passport.code), manifest.version);
const rows = manifest.passports.map((passport) => ({
  passport,
  status: details[passport.code]?.statuses[destination.code] ?? "unknown" as AccessStatus,
}));
const counts = Object.fromEntries(ACCESS_STATUSES.map((status) => [status, rows.filter((row) => row.status === status).length])) as Record<AccessStatus, number>;
const policies = policiesForDestination(destination.code);
const officialSources = officialSourcesForPolicies(policies);
const checkedDate = new Intl.DateTimeFormat("en", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(manifest.checkedAt));
const canonical = `/destination/${destinationSlug(destination)}`;
const title = `${destination.name} Visa Requirements by Passport | MultiPass Rank`;
const description = `Compare current ${destination.name} visa requirements for ${manifest.passports.length} passports, with official-source evidence, policy history, and direct relationship pages.`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Destinations", item: "https://multipassrank.com/destinations" },
      { "@type": "ListItem", position: 2, name: destination.name, item: `https://multipassrank.com${canonical}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `${destination.name} entry requirements by passport nationality`,
    description,
    dateModified: manifest.checkedAt,
    spatialCoverage: destination.name,
    temporalCoverage: `${manifest.checkedAt.slice(0, 10)}/..`,
    keywords: [destination.name, "visa requirements", "passport", "visa-free", "eVisa", "ETA"],
    citation: officialSources.map((officialSource) => officialSource.url),
    ...datasetMetadata(`https://multipassrank.com${canonical}`),
  },
];
Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout title={title} description={description} canonical={canonical} markdownHref={`${canonical}.md`} structuredData={structuredData}>
  <header class="destination-hero">
    <span class="country-flag" aria-hidden="true">{flagEmojiFor(destination.code)}</span>
    <div>
      <span class="eyebrow">{formatRegion(destination.region)} destination</span>
      <h1>{destination.name} visa requirements</h1>
      <p>Current entry categories for {manifest.passports.length} passport nationalities, paired with official evidence as it is reviewed.</p>
      <div class="visa-relation-meta">
        <span>{source === "live" ? "Access data checked" : "Bundled access snapshot"} {checkedDate}</span>
        <span>{officialSources.length} official {officialSources.length === 1 ? "source" : "sources"} collected</span>
      </div>
    </div>
  </header>

  <section class="status-summary destination-status-summary" aria-label="Access type totals">
    {ACCESS_STATUSES.filter((status) => counts[status] > 0).map((status) => (
      <span><i class={`status-dot status-dot--${status}`}></i><span>{STATUS_META[status].label}</span><strong>{counts[status]}</strong></span>
    ))}
  </section>

  <section class="section section--tight">
    <div class="section-heading">
      <div><span class="eyebrow">Passport directory</span><h2>Access by passport</h2></div>
      <p>Open any status for its canonical passport–destination page, evidence timeline, official sources, and application route where available.</p>
    </div>
    <DestinationPassportAccess destination={destination} rows={rows} />
  </section>

  <section class="section section--tight destination-evidence">
    <div class="section-heading">
      <div><span class="eyebrow">Policy history</span><h2>Official evidence timeline</h2></div>
      <p>One group agreement or destination policy can support many passport relationships. Dates are recorded only when an official source establishes them.</p>
    </div>
    <VisaEvidenceTimeline policies={policies} sources={officialSources} passports={manifest.passports} showAffectedPassports />
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  CITIZENSHIP_ACQUISITION_ROUTES,
  CITIZENSHIP_ROUTE_TYPE_LABELS,
  type CitizenshipAcquisitionRouteType,
} from "@/data/citizenship-acquisition";
import { datasetMetadata } from "@/lib/dataset";
import { flagEmojiFor } from "@/lib/geography";

const description = "Compare reviewed citizenship-by-descent and residence-based naturalisation routes using current official government sources, requirements, review dates, and transition notes.";
const routeTypes: CitizenshipAcquisitionRouteType[] = ["descent", "naturalisation", "marriage", "restoration", "exceptional"];
const activeTypes = routeTypes.filter((type) => CITIZENSHIP_ACQUISITION_ROUTES.some((route) => route.type === type));
const countryCount = new Set(CITIZENSHIP_ACQUISITION_ROUTES.map((route) => route.countryCode)).size;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Reviewed citizenship acquisition routes",
    description,
    dateModified: "2026-08-31",
    spatialCoverage: [...new Set(CITIZENSHIP_ACQUISITION_ROUTES.map((route) => route.country))],
    distribution: {
      "@type": "DataDownload",
      contentUrl: "https://multipassrank.com/api/v1/citizenship-acquisition",
      encodingFormat: "application/json",
    },
    ...datasetMetadata("https://multipassrank.com/citizenship-by-descent"),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "MultiPass Rank", item: "https://multipassrank.com" },
      { "@type": "ListItem", position: 2, name: "Citizenship by descent and naturalisation", item: "https://multipassrank.com/citizenship-by-descent" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Can citizenship by descent be determined from a passport combination calculator?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Descent depends on the family record, dates, prior naturalisation or loss events, filing deadlines, and the current law of the country concerned. MultiPass Rank links each reviewed route to an official authority.",
        },
      },
      {
        "@type": "Question",
        name: "Which residence period applies to Portuguese naturalisation in 2026?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "For applications under the Portuguese reform effective 19 May 2026, the official Ministry of Justice states seven years for nationals of EU or Portuguese-speaking countries and ten years for nationals of other states. Pending applications remain under the prior law.",
        },
      },
    ],
  },
];

Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=86400, stale-while-revalidate=604800");
---

<BaseLayout
  title="Citizenship by Descent & Naturalisation Requirements | MultiPass Rank"
  description={description}
  canonical="/citizenship-by-descent"
  markdownHref="/citizenship-by-descent.md"
  structuredData={structuredData}
>
  <article class="citizenship-guide acquisition-guide">
    <header class="research-hero citizenship-guide__hero">
      <span class="eyebrow">Official-source route review · 31 August 2026</span>
      <h1>Citizenship by descent—and what the shortcut leaves out.</h1>
      <p>
        A family connection can open a route, but dates, documents, residence, language, and nationality-retention rules decide the outcome.
        This growing dataset keeps each claim attached to a current government source.
      </p>
      <div class="research-actions research-actions--hero">
        <a class="button button--primary" href="/dual-citizenship-countries">Check dual-citizenship rules</a>
        <a class="button button--quiet" href="/compare">Model the travel-access result</a>
      </div>
    </header>

    <section class="citizenship-explainer" aria-label="How to use citizenship route records">
      <article><span class="policy-dot"></span><h2>Route, not promise</h2><p>A listed route means an official authority describes it. It does not establish an individual's eligibility.</p></article>
      <article><span class="policy-dot policy-dot--conditional"></span><h2>Dates matter</h2><p>Family events, naturalisation dates, filing dates, and reforms can change the applicable rule.</p></article>
      <article><span class="policy-dot policy-dot--generally_restricted"></span><h2>Retention is separate</h2><p>Qualifying to acquire one citizenship does not prove that every citizenship in a proposed set can be kept.</p></article>
    </section>

    <div class="citizenship-guide__scope">
      <strong>{CITIZENSHIP_ACQUISITION_ROUTES.length} routes across {countryCount} countries</strong>
      <p>Only researched routes appear. Missing countries and route types are unknown, never assumed unavailable.</p>
    </div>

    {activeTypes.map((type) => {
      const routes = CITIZENSHIP_ACQUISITION_ROUTES.filter((route) => route.type === type);
      return (
        <section class="acquisition-route-group">
          <header>
            <span class="eyebrow">Reviewed acquisition routes</span>
            <h2>{CITIZENSHIP_ROUTE_TYPE_LABELS[type]}</h2>
            <strong>{routes.length}</strong>
          </header>
          <div class="acquisition-route-list">
            {routes.map((route) => (
              <article id={route.id}>
                <div class="citizenship-policy-card__heading">
                  <span class="country-flag" aria-hidden="true">{flagEmojiFor(route.countryCode)}</span>
                  <div><h3>{route.country}</h3><span>Reviewed {route.reviewedAt}</span></div>
                </div>
                <strong>{route.title}</strong>
                <p>{route.summary}</p>
                <ul>{route.requirements.map((requirement) => <li>{requirement}</li>)}</ul>
                {(route.residenceRequirement || route.languageRequirement) && (
                  <dl class="acquisition-route-card__facts">
                    {route.residenceRequirement && <div><dt>Residence</dt><dd>{route.residenceRequirement}</dd></div>}
                    {route.languageRequirement && <div><dt>Language</dt><dd>{route.languageRequirement}</dd></div>}
                  </dl>
                )}
                {route.transitionNote && <p class="acquisition-route-card__transition"><strong>Current-law note:</strong> {route.transitionNote}</p>}
                <div class="citizenship-policy-card__sources">
                  <span>Official {route.sources.length === 1 ? "source" : "sources"}</span>
                  {route.sources.map((source) => <a href={source.url} rel="noreferrer">{source.publisher}: {source.label}</a>)}
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="research-copy citizenship-guide__limits">
      <section>
        <span class="eyebrow">How this dataset should grow</span>
        <h2>One reviewed route at a time.</h2>
        <p>
          The next passes should add a route only when an official authority establishes the eligibility class and current procedure.
          Residence periods, language tests, renunciation, effective dates, and transitional rules belong in separate fields so an old
          five-year summary cannot silently survive a new ten-year law.
        </p>
        <p>
          Use the <a href="/dual-citizenship-countries">compatibility register</a> after finding a possible route, then use the
          <a href="/rank">combined ranking</a> to model the hypothetical mobility outcome. Neither result is legal advice.
        </p>
      </section>
    </section>
  </article>
</BaseLayout>

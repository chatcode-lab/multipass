---
import { getPopularComparison } from "@/lib/geography";

const comparison = getPopularComparison(Astro.params.slug);
if (!comparison) return Astro.rewrite("/404");
return new Response(null, {
  status: 308,
  headers: {
    Location: `/${comparison.slug}`,
    "Cache-Control": "public, max-age=3600",
  },
});
---

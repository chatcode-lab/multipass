---
import AccessList from "@/components/AccessList";
import PassportCover from "@/components/PassportCover";
import RegionMap from "@/components/RegionMap.astro";
import CountryIndicators from "@/components/CountryIndicators.astro";
import StatusPill from "@/components/StatusPill";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDataContext, getPassportAccess } from "@/lib/data";
import { datasetMetadata } from "@/lib/dataset";
import { collectionForRegion, comparisonHref, formatRegion, improveHref, relatedPassports } from "@/lib/geography";
import { ACCESS_STATUSES, type AccessStatus } from "@/lib/types";
import { citizenshipPolicyAnchor, citizenshipPolicyFor } from "@/lib/citizenship-compatibility";
import { CITIZENSHIP_ACQUISITION_ROUTES_BY_COUNTRY } from "@/data/citizenship-acquisition";
import { passportPageTitle } from "@/lib/seo-titles";
import { resolvePassportBySlug } from "@/lib/visa-evidence";
import { countryTopics, countryTopicHref, TOPIC_LABELS } from "@/lib/country-profiles";
import { countryIndicators } from "@/lib/country-indicators";

const { manifest, source } = await getDataContext(Astro.locals);
const passport = resolvePassportBySlug(Astro.params.slug, manifest);
if (!passport) return Astro.rewrite("/404");
if (Astro.params.slug !== passport.slug) {
  return new Response(null, {
    status: 308,
    headers: { Location: `/passport/${passport.slug}`, "Cache-Control": "public, max-age=3600" },
  });
}
const detail = await getPassportAccess(Astro.locals, passport.code, manifest.version);
if (!detail) return Astro.rewrite("/404");

const statusCounts = Object.fromEntries(ACCESS_STATUSES.map((status) => [status, 0])) as Record<AccessStatus, number>;
for (const status of Object.values(detail.statuses)) statusCounts[status] += 1;
const checkedDate = new Intl.DateTimeFormat("en", { day: "numeric", month: "long", year: "numeric" }).format(
  new Date(manifest.checkedAt),
);
const regionLabel = formatRegion(passport.region);
const regionalPassports = manifest.passports.filter((entry) => entry.region === passport.region);
const regionalRank = regionalPassports.findIndex((entry) => entry.code === passport.code) + 1;
const regionCollection = collectionForRegion(passport.region);
const comparisonPassports = relatedPassports(passport, manifest.passports);
const citizenshipPolicy = citizenshipPolicyFor(passport.code);
const citizenshipRoutes = CITIZENSHIP_ACQUISITION_ROUTES_BY_COUNTRY.get(passport.code) ?? [];
Astro.response.headers.set("Cache-Control", "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400");

const title = passportPageTitle(passport);
const description = `The ${passport.name} passport ranks #${passport.rank} globally. See ${statusCounts.visa_free} visa-free countries, ${statusCounts.visa_on_arrival} visa-on-arrival destinations, and every current access category.`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Passport ranking", item: "https://multipassrank.com/" },
      { "@type": "ListItem", position: 2, name: passport.name, item: `https://multipassrank.com/passport/${passport.slug}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `${passport.name} passport destination access`,
    description,
    dateModified: manifest.checkedAt,
    spatialCoverage: "Worldwide",
    keywords: [passport.name, "passport", "visa requirements", "visa-free destinations", "mobility score"],
    distribution: {
      "@type": "DataDownload",
      contentUrl: `https://multipassrank.com/api/v1/passports/${passport.code}`,
      encodingFormat: "application/json",
    },
    ...datasetMetadata(`https://multipassrank.com/passport/${passport.slug}`),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`/passport/${passport.slug}`}
  markdownHref={`/passport/${passport.slug}.md`}
  jsonHref={`/api/v1/passports/${passport.code}`}
  structuredData={structuredData}
>
  <header class="passport-hero">
    <PassportCover codes={[passport.code]} names={[passport.name]} size="large" />
    <div class="passport-hero__content">
      <span class="eyebrow">{regionLabel} passport</span>
      <h1>{passport.name} passport rank</h1>
      <span class="passport-hero__meta">Visa-free countries and complete destination-by-destination access.</span>
      <div class="metric-strip">
        <div><span>Global rank</span><strong>#{passport.rank}</strong></div>
        <div><span>Mobility score</span><strong>{passport.mobilityScore}</strong></div>
        <div><span>Destinations tracked</span><strong>{manifest.destinations.length}</strong></div>
      </div>
      <div class="passport-hero__actions">
        <a class="button button--primary" href={`/compare?set=${passport.code}`}>Compare this passport</a>
        <a class="button button--quiet" href={improveHref([[passport.code]])}>Improve this passport</a>
        <a class="button button--quiet" href={`/rank?set=${passport.code}`}>Place in ranking</a>
        <span class:list={["freshness", source === "fallback" && "freshness--fallback"]}>{source === "live" ? "Checked" : "Bundled snapshot"} {checkedDate}</span>
      </div>
    </div>
  </header>

  <section class="country-overview">
    <div class="country-overview__copy">
      <span class="eyebrow">Passport overview</span>
      <h2>About the {passport.name} passport</h2>
      <p>
        The {passport.name} passport is grouped with {regionLabel} in this index. It ranks
        <strong> #{passport.rank} globally</strong> and <strong>#{regionalRank} among {regionalPassports.length} {regionLabel} passports</strong>,
        with a mobility score of {passport.mobilityScore}.
      </p>
      <p>
        Its current access profile includes {statusCounts.visa_free} visa-free destinations,
        {statusCounts.visa_on_arrival} visas on arrival, and {statusCounts.eta} destinations using an ETA.
        The detailed list below separates these from eVisas, traditional visas, and any officially documented entry restrictions.
      </p>
      <nav class="country-shortcuts" aria-label={`Explore ${passport.name} passport comparisons`}>
        {countryTopics(passport.code).map((topic) => <a href={countryTopicHref(passport.slug, topic.topic)}>{TOPIC_LABELS[topic.topic]}</a>)}
        {countryIndicators(passport.code).length > 0 && <a href="#country-indicators-heading">Living indicators</a>}
        {regionCollection && <a href={`/${regionCollection.slug}`}>See {regionCollection.name} ranking</a>}
        {passport.code === "US" && <a href="/best-second-passport-for-us-citizens">Best second passport by marginal access</a>}
        {comparisonPassports.map((other) => (
          <a href={comparisonHref([[passport.code], [other.code]])}>Compare to {other.name}</a>
        ))}
      </nav>
    </div>
    <RegionMap code={passport.code} country={passport.name} region={passport.region} />
  </section>

  {countryTopics(passport.code).length > 0 && <section class="passport-topic-links" aria-label="Citizenship and tax context">
    {countryTopics(passport.code).map((topic) => <article><a href={countryTopicHref(passport.slug, topic.topic)}>{TOPIC_LABELS[topic.topic]} →</a><p>{topic.summary}</p></article>)}
  </section>}

  {citizenshipPolicy && (
    <aside class:list={["passport-citizenship-note", `passport-citizenship-note--${citizenshipPolicy.status}`]}>
      <div>
        <span class="eyebrow">Multiple-citizenship policy</span>
        <h2>{citizenshipPolicy.headline}</h2>
        <p>{citizenshipPolicy.summary}</p>
      </div>
      <div class="passport-citizenship-note__actions">
        <a class="button button--quiet" href={`/dual-citizenship-countries#${citizenshipPolicyAnchor(citizenshipPolicy)}`}>Review policy sources</a>
        {citizenshipRoutes.length > 0 && <a class="text-link" href={`/citizenship-by-descent#${citizenshipRoutes[0].id}`}>See acquisition routes</a>}
      </div>
    </aside>
  )}

  <section class="section section--tight">
    <div class="section-heading">
      <div><span class="eyebrow">All destinations</span><h2>Access details</h2><a class="text-link" href="/destinations">Browse the destination directory</a></div>
      <p>Entry rules can change without notice. Treat this as a comparison tool and verify official requirements before travel.</p>
    </div>
    <div class="status-summary" aria-label="Access type totals">
      {ACCESS_STATUSES.filter((status) => statusCounts[status] > 0).map((status) => (
        <span><StatusPill status={status} compact /><strong>{statusCounts[status]}</strong></span>
      ))}
    </div>
    <a class="status-guide-link" href="/evisa-vs-eta">Not sure how an ETA differs from an eVisa?</a>
    <AccessList passport={detail} destinations={manifest.destinations} client:visible />
  </section>
  <CountryIndicators code={passport.code} />
</BaseLayout>
<style>
  .passport-topic-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px;margin-bottom:24px}.passport-topic-links article{border:1px solid var(--line);padding:18px 20px;min-width:0}.passport-topic-links a{color:var(--green);font-weight:700;font-size:14px;text-underline-offset:4px}.passport-topic-links p{color:var(--ink-soft);font-size:13px;line-height:1.5;margin:8px 0 0}
</style>

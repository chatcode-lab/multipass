---
import PassportBuilder from "@/components/PassportBuilder.astro";
import RankingExplorer from "@/components/RankingExplorer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDataContext } from "@/lib/data";
import { PASSPORT_COLLECTIONS } from "@/lib/geography";

const { manifest, source } = await getDataContext(Astro.locals);
const rankedCodes = new Set(manifest.passports.map((passport) => passport.code));
const unrankedDestinations = manifest.destinations.filter((destination) => !rankedCodes.has(destination.code));
const checkedDate = new Intl.DateTimeFormat("en", { day: "numeric", month: "short", year: "numeric" }).format(
  new Date(manifest.checkedAt),
);
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=1800, stale-while-revalidate=86400");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "MultiPass Rank passport combination calculator",
  url: "https://multipassrank.com",
  applicationCategory: "TravelApplication",
  operatingSystem: "Any",
  description: "Calculate passport strength, combined passport power, rankings, and destination access.",
  featureList: "Passport ranking, passport combination calculator, destination access comparison",
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="Passport Combination Calculator & Global Ranking | MultiPass Rank"
  description="Calculate combined passport power, compare passport strength across 227 destinations, and explore the current global passport ranking."
  markdownHref="/index.md"
  structuredData={structuredData}
>
  <section class="hero">
    <div class="hero__copy">
      <span class="eyebrow">Global passport access, made practical</span>
      <h1>Passport ranks.<br /><em>Combined.</em></h1>
      <p>See where one passport gets you—and what changes when you can travel with more than one.</p>
      <div class="hero__facts" aria-label="Dataset summary">
        <span><strong>{manifest.passports.length}</strong> passports</span>
        <a href="/destinations"><strong>{manifest.destinations.length}</strong> destinations</a>
      </div>
    </div>
    <PassportBuilder passports={manifest.passports} />
  </section>

  <section class="calculator-explainer" aria-labelledby="calculator-explainer-title">
    <div>
      <span class="eyebrow">Passport strength calculator</span>
      <h2 id="calculator-explainer-title">Calculate combined passport power.</h2>
    </div>
    <p>
      A combination is scored destination by destination, using the easiest access from any selected passport.
      That exposes the practical gain from a second citizenship instead of simply adding two headline scores.{" "}
      <a href="/methodology">See how the ranking works</a>, or
      {" "}<a href="/best-passport-combination">explore the exact best pairs and triples</a>. Curious about the legal ceiling?{" "}
      <a href="/how-many-passports-can-you-have">See how many citizenships one person may hold</a>, then{" "}
      <a href="/dual-citizenship-countries">check whether a combination may be compatible</a>.
    </p>
  </section>

  <section class="section" id="ranking">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Current index</span>
        <h2>Global ranking</h2>
      </div>
      <div>
        <p>Ranked by destinations available without prior visa approval: visa-free, visa on arrival, or ETA.</p>
        <span class:list={["freshness", source === "fallback" && "freshness--fallback"]}>
          {source === "live" ? "Data checked" : "Bundled snapshot"} {checkedDate}
        </span>
      </div>
    </div>
    <nav class="collection-links" aria-label="Focused passport rankings">
      {PASSPORT_COLLECTIONS.map((collection) => <a href={`/${collection.slug}`}>{collection.name}</a>)}
    </nav>
    <RankingExplorer passports={manifest.passports} unranked={unrankedDestinations} />
  </section>
</BaseLayout>

{
  "name": "multipass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passport ranking and multi-passport comparison tool for multipassrank.com",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build",
    "data:fallback": "tsx scripts/build-fallback.ts",
    "data:kv-bulk": "tsx scripts/build-kv-bulk.ts",
    "data:bootstrap": "tsx scripts/bootstrap-worker.ts",
    "cf:set-kv": "tsx scripts/set-kv-id.ts",
    "cf:typegen": "wrangler types --config wrangler.worker.jsonc && wrangler types --config wrangler.jsonc",
    "worker:dev": "wrangler dev --config wrangler.worker.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.worker.jsonc",
    "app:deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "npm run worker:deploy && npm run app:deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.2",
    "@astrojs/react": "^6.0.3",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "astro": "^7.2.3",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.544.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}

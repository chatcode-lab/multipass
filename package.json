{
  "name": "multipass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passport ranking and multi-passport comparison tool for multipassrank.com",
  "license": "MIT",
  "homepage": "https://multipassrank.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatcode-lab/multipass.git"
  },
  "bugs": {
    "url": "https://github.com/chatcode-lab/multipass/issues"
  },
  "keywords": [
    "passport-ranking",
    "passport-comparison",
    "visa-requirements",
    "astro",
    "cloudflare-workers"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=low",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run evidence:audit-coverage && npm run build",
    "data:fallback": "tsx scripts/build-fallback.ts",
    "data:insights": "tsx scripts/build-combination-insights.ts",
    "data:kv-bulk": "tsx scripts/build-kv-bulk.ts",
    "data:bootstrap": "tsx scripts/bootstrap-worker.ts",
    "assets:map": "tsx scripts/build-map.ts",
    "assets:passports": "tsx scripts/build-passport-colors.ts",
    "evidence:packet": "tsx scripts/build-evidence-packet.ts",
    "evidence:coverage": "tsx scripts/report-evidence-coverage.ts",
    "profiles:coverage": "tsx scripts/report-country-profile-coverage.ts",
    "evidence:expiries": "tsx scripts/report-evidence-expiries.ts",
    "evidence:audit-coverage": "tsx scripts/report-evidence-audit-coverage.ts --fail-on-gaps",
    "evidence:promote": "tsx scripts/promote-evidence-batches.ts",
    "evidence:validate": "tsx scripts/validate-evidence-candidate.ts",
    "evidence:source-health": "tsx scripts/source-health/index.ts",
    "evidence:discovery": "tsx scripts/validate-prioritize-visa-discovery.ts",
    "evidence:discovery-diff": "tsx scripts/build-discovery-catalog-diff.ts",
    "cf:set-kv": "tsx scripts/set-kv-id.ts",
    "cf:typegen": "wrangler types --config wrangler.worker.jsonc && wrangler types --config wrangler.jsonc",
    "worker:dev": "wrangler dev --config wrangler.worker.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.worker.jsonc",
    "app:deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "npm run worker:deploy && npm run app:deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "astro": "^7.4.7",
    "lucide-react": "^0.577.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.3.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.156.2"
  }
}
